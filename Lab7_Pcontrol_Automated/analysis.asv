
%% ------------------------------------------------- Constants -------------------------------------------------
close all; clc; clear;

time = transpose(0:1999);

%% ------------------------------------------------- Folder Loading -------------------------------------------------

files = dir(fullfile("data", "*.txt")); % Load only files that are .txt
fprintf("\nFound %d files in folder\n\n", length(files));

for k = 1:length(files)
    disp(files(k).name);
end

%% ------------------------------------------------- Data Sorting -------------------------------------------------
s = struct();

for i = 1:length(files)
    name = files(i).name;
    name = erase(name, ".txt");
    s.(name).data = load(fullfile(files(i).folder, files(i).name));
    s.(name).time = time; % Time vector
end

%% ------------------------------------------------- Plotting -------------------------------------------------

fns = fieldnames(s);

for j = 1:length(fns)
    figure("Name", fns{j})
    plot(s.(fns{j}).time, s.(fns{j}).data)
end

%% ------------------------------------------------- Analysis -------------------------------------------------
y_osc_uw = s.ex2_uw_0p01_oscilates.data 
y_osc_w = s.ex2_w_0p009_oscilates.data - mean(s.ex2_uw_0p01_oscilates.data);

% Count zero crossings
[~, count] = zerocrossrate(y_osc_uw);
disp(['Total zero crossings: ', num2str(count)]);

freq = count/(2*(2000/1000));
disp(['Freq Hz ', num2str(freq)]);

[~, count] = zerocrossrate(y_osc_w);
disp(['Total zero crossings: ', num2str(count)]);

freq = count/(2*(2000/1000));
disp(['Freq Hz ', num2str(freq)]);